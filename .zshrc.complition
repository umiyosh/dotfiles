## Completion configuration
#
# completion
# fpath=($fpath $HOME/local/functions(N))
# brew shellenv はログインシェルでだけ Homebrew の補完を fpath に足す。
# 通常のシェルでも足して件数を揃えないと、交互に起動するたびに .zcompdump が作り直される
typeset -gU fpath
fpath=(~/.zsh/functions/Completion ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions(N) ${fpath})

autoload -Uz compinit
# .zcompdump が 24 時間以内に更新されていれば、fpath の走査を省いて読む。
# 走査した日は、件数が同じでもダンプが書き換わらないので更新時刻だけ進める
_zcompdump_fresh=(${ZDOTDIR:-$HOME}/.zcompdump(N.mh-24))
if (( $#_zcompdump_fresh )); then
  compinit -C -u
else
  compinit -u && touch ${ZDOTDIR:-$HOME}/.zcompdump
fi
unset _zcompdump_fresh

# sudoも補完の対象
zstyle ':completion:*:sudo:*' command-path /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin

# 色付きで補完する
zstyle ':completion:*' list-colors di=34 fi=0
#zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B--- %d ---%b'

zstyle ':completion:*' menu select
zstyle ':completion:*:default' list-colors ln=35 di=36

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

zstyle ':completion:*:kill:*:processes' command 'ps x'
zstyle ':completion:*:-command-:*' \
    fake-parameters PERL5LIB # for perl
zstyle ':completion:*' completer _oldlist _complete _prefix _list _history

# source <(kubectl completion zsh)

